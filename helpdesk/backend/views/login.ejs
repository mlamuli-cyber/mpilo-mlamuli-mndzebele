<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Sign In' }) %>
</head>
<body class="auth-body">
  <div class="tech-pattern" aria-hidden="true"></div>
  <div class="auth-wrap">
    <a href="/" class="auth-back">&larr; Back to home</a>
    <div class="auth-card">
      <div class="auth-brand">
        <span class="brand-mark brand-mark-lg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 6.5V12c0 5.2 3.8 9.5 9 10 5.2-.5 9-4.8 9-10V6.5L12 2Z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <h1>Help Desk</h1>
      </div>
      <p class="auth-sub">Sign in with the username and password provided by your administrator.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login" class="auth-form" autocomplete="off" data-clear-on-load>
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          autocomplete="off"
          readonly
          onfocus="this.removeAttribute('readonly')"
          required
          autofocus
        />

        <label for="password">Password</label>
        <div class="password-field">
          <input
            type="password"
            id="password"
            name="password"
            autocomplete="off"
            readonly
            onfocus="this.removeAttribute('readonly')"
            required
          />
          <button type="button" class="pw-toggle" aria-label="Show password" tabindex="-1"></button>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Sign In</button>
      </form>

      <p class="auth-footnote">Don't have an account? Contact your administrator to get set up.</p>
    </div>
    <p class="auth-copyright">&copy; <%= new Date().getFullYear() %> Help Desk · Internal Support Platform</p>
  </div>
</body>
</html>
