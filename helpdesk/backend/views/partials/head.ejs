<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script>
  // Applied before first paint so switching pages never flashes the wrong theme.
  (function () {
    try {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
    } catch (e) {}
  })();
</script>
<title><%= typeof title !== 'undefined' ? title + ' · Help Desk' : 'Help Desk' %></title>
<meta name="description" content="Internal help desk for logging, tracking, and resolving support tickets." />
