<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Overview' }) %>
</head>
<body>
  <div class="page-shell">
  <%- include('partials/nav', { active: 'admin-dashboard' }) %>

  <main class="container">
    <% const hour = new Date().getHours();
       const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
       const firstName = currentUser.full_name.trim().split(/\s+/)[0];
    %>
    <div class="welcome-banner">
      <div>
        <span class="welcome-eyebrow"><%= greeting %> · <%= currentUser.role === 'admin' ? 'Administrator' : 'Technician' %></span>
        <h1><%= firstName %>, here's the team snapshot.</h1>
        <p class="muted">
          <% if (myOpenCount > 0) { %>
            You have <strong><%= myOpenCount %></strong> ticket<%= myOpenCount === 1 ? '' : 's' %> assigned to you
            <% if (unassignedCount > 0) { %> · <strong><%= unassignedCount %></strong> waiting to be claimed<% } %>.
          <% } else if (unassignedCount > 0) { %>
            Nothing assigned to you right now — <strong><%= unassignedCount %></strong> ticket<%= unassignedCount === 1 ? '' : 's' %> waiting to be claimed.
          <% } else { %>
            All caught up — nothing assigned to you and nothing waiting in the queue.
          <% } %>
        </p>
      </div>
      <div class="quick-actions">
        <a href="/tickets/new" class="btn btn-ghost btn-sm">Log a Ticket</a>
        <a href="/admin/tickets?assigned=unassigned" class="btn btn-ghost btn-sm">View Unassigned</a>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/users" class="btn btn-ghost btn-sm">Add User</a>
          <a href="/admin/departments" class="btn btn-primary btn-sm">Manage Departments</a>
        <% } %>
      </div>
    </div>

    <div class="overview-grid">
      <div class="stat-row stat-row-compact">
        <div class="stat-card">
          <span class="stat-number"><%= counts.total || 0 %></span>
          <span class="stat-label">Total Tickets</span>
        </div>
        <div class="stat-card stat-open">
          <span class="stat-number"><%= counts.open || 0 %></span>
          <span class="stat-label">Open</span>
        </div>
        <div class="stat-card stat-progress">
          <span class="stat-number"><%= counts.inProgress || 0 %></span>
          <span class="stat-label">In Progress</span>
        </div>
        <div class="stat-card stat-done">
          <span class="stat-number"><%= counts.done || 0 %></span>
          <span class="stat-label">Done</span>
        </div>
        <div class="stat-card stat-warn">
          <span class="stat-number"><%= unassignedCount %></span>
          <span class="stat-label">Unassigned</span>
        </div>
        <div class="stat-card">
          <span class="stat-number"><%= myOpenCount %></span>
          <span class="stat-label">Assigned to Me</span>
        </div>
        <div class="stat-card">
          <span class="stat-number"><%= technicianCount %></span>
          <span class="stat-label">Technicians</span>
        </div>
        <div class="stat-card">
          <span class="stat-number"><%= departmentCount %></span>
          <span class="stat-label">Departments</span>
        </div>
        <div class="stat-card">
          <span class="stat-number"><%= userCount %></span>
          <span class="stat-label">Users &amp; Clients</span>
        </div>
      </div>

      <% const total = counts.total || 0;
         const openPct = total ? Math.round((counts.open / total) * 100) : 0;
         const progPct = total ? Math.round((counts.inProgress / total) * 100) : 0;
         const gradient = total
           ? `conic-gradient(#2f5fdd 0 ${openPct}%, #d8860a ${openPct}% ${openPct + progPct}%, #1f9d61 ${openPct + progPct}% 100%)`
           : `conic-gradient(#e2e6ec 0 100%)`;
      %>
      <div class="card donut-card">
        <h2 class="section-title">Ticket Breakdown</h2>
        <div class="donut-wrap">
          <div class="donut" style="background: <%= gradient %>;">
            <div class="donut-hole">
              <span class="donut-total"><%= total %></span>
              <span class="donut-label">tickets</span>
            </div>
          </div>
          <ul class="donut-legend">
            <li><span class="dot dot-open"></span> Open <strong><%= counts.open || 0 %></strong></li>
            <li><span class="dot dot-progress"></span> In Progress <strong><%= counts.inProgress || 0 %></strong></li>
            <li><span class="dot dot-done"></span> Done <strong><%= counts.done || 0 %></strong></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="two-col">
      <div class="card">
        <div class="card-header-row">
          <h2 class="section-title">My Queue</h2>
          <a href="/admin/tickets?assigned=me" class="link">View all &rarr;</a>
        </div>
        <% if (myQueue.length === 0) { %>
          <div class="empty-state empty-state-sm"><p>Nothing assigned to you right now.</p></div>
        <% } else { %>
          <ul class="queue-list">
            <% myQueue.forEach(function(t) { %>
              <li onclick="window.location='/tickets/<%= t.id %>'">
                <span class="badge priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span>
                <div class="queue-body">
                  <span class="ticket-title-cell"><%= t.title %></span>
                  <span class="muted"><%= t.number %> · <%= t.department_name %></span>
                </div>
                <span class="badge status-<%= t.status.replace(' ', '-').toLowerCase() %>"><%= t.status %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <div class="card">
        <h2 class="section-title">By Priority</h2>
        <p class="muted chart-caption">Active tickets (Open + In Progress) needing attention.</p>
        <div class="bar-list">
          <% priorityBreakdown.forEach(function(p) { %>
            <div class="bar-row">
              <span class="bar-label priority-<%= p.priority.toLowerCase() %>-text"><%= p.priority %></span>
              <div class="bar-track">
                <div class="bar-fill priority-<%= p.priority.toLowerCase() %>-fill" style="width: <%= Math.round((p.count / priorityMax) * 100) %>%;"></div>
              </div>
              <span class="bar-count"><%= p.count %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="two-col">
      <div class="card">
        <h2 class="section-title">By Department</h2>
        <p class="muted chart-caption">Active tickets per department.</p>
        <div class="bar-list">
          <% departmentBreakdown.forEach(function(d) { %>
            <div class="bar-row">
              <span class="bar-label"><%= d.name %></span>
              <div class="bar-track">
                <div class="bar-fill bar-fill-neutral" style="width: <%= Math.round((d.c / departmentMax) * 100) %>%;"></div>
              </div>
              <span class="bar-count"><%= d.c %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="card">
        <h2 class="section-title">Recent Activity</h2>
        <% if (recentActivity.length === 0) { %>
          <div class="empty-state empty-state-sm"><p>No comments logged yet.</p></div>
        <% } else { %>
          <ul class="activity-feed">
            <% recentActivity.forEach(function(a) { %>
              <li>
                <span class="avatar avatar-sm role-avatar-<%= a.commenter_role %>"><%= a.commenter_name.trim().split(/\s+/).map(function(p){return p[0];}).slice(0,2).join('').toUpperCase() %></span>
                <div class="activity-body">
                  <p><strong><%= a.commenter_name %></strong> <span class="role-pill role-<%= a.commenter_role %>"><%= a.commenter_role %></span> commented on <a href="/tickets/<%= a.ticket_id %>"><%= a.ticket_number %></a></p>
                  <p class="activity-message">"<%= a.message.length > 110 ? a.message.slice(0, 110) + '…' : a.message %>"</p>
                </div>
                <span class="muted activity-time" title="<%= a.created_at %>"><%= a.age %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header-row">
        <h2 class="section-title">Recent Tickets</h2>
        <a href="/admin/tickets" class="link">View all &rarr;</a>
      </div>

      <% if (recentTickets.length === 0) { %>
        <div class="empty-state"><p>No tickets have been logged yet.</p></div>
      <% } else { %>
        <table class="table">
          <thead>
            <tr>
              <th>Ticket</th>
              <th>Department</th>
              <th>Reported By</th>
              <th>Assigned To</th>
              <th>Priority</th>
              <th>Status</th>
              <th>Logged</th>
            </tr>
          </thead>
          <tbody>
            <% recentTickets.forEach(function(t) { %>
              <tr onclick="window.location='/tickets/<%= t.id %>'" class="clickable-row">
                <td>
                  <span class="ticket-number"><%= t.number %></span>
                  <span class="ticket-title-cell"><%= t.title %></span>
                </td>
                <td><%= t.department_name %></td>
                <td>
                  <%= t.created_by_name %>
                  <% if (t.created_by_role === 'client') { %><span class="badge badge-client">Client</span><% } %>
                </td>
                <td><% if (t.assignee_name) { %><%= t.assignee_name %><% } else { %><span class="badge badge-unassigned">Unassigned</span><% } %></td>
                <td><span class="badge priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
                <td><span class="badge status-<%= t.status.replace(' ', '-').toLowerCase() %>"><%= t.status %></span></td>
                <td class="muted" title="<%= t.created_at %>"><%= t.age %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
  </div>
</body>
</html>
